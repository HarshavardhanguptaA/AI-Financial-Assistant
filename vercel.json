{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "public": false,
  "builds": [
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/styles.css",
      "dest": "/public/styles.css"
    },
    {
      "src": "/app.js",
      "dest": "/public/app.js"
    },
    {
      "src": "/config.js",
      "dest": "/public/config.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}

